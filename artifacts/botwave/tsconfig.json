{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "src/lib/supabase/**/*",
    "src/lib/health-monitor.ts",
    "src/lib/redisApiCache.ts",
    "src/lib/sitemap/chunks.ts",
    "src/lib/study/extractors.ts",
    "src/lib/telegram-auth.ts",
    "src/lib/tycoon/auth.ts",
    "src/lib/tycoon/errors.ts",
    "src/lib/tycoon/quests.ts",
    "src/lib/tycoon/state.ts",
    "src/lib/tycoon/tickWorker.ts",
    "src/lib/botwave-knowledge.ts",
    "src/lib/email-service.ts",
    "src/lib/email/bounce.ts",
    "src/lib/email/queue.ts",
    "src/lib/email/spam-protection.ts",
    "src/lib/email/transporter.ts",
    "src/lib/email/verification-store.ts",
    "src/lib/game/chess-engine.ts",
    "src/lib/admin-security.ts",
    "src/components/docs/MarkdownRenderer.tsx",
    "src/components/ui/QRCodeDisplay.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
