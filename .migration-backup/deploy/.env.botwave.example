# ========================================================
# BotWave Environment Variables
# Copy to .env.botwave and fill in your values
# ========================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Internal Auth ──
# Secret key for internal auth between web and bot services
# Generate: openssl rand -hex 32
BOT_SECRET_KEY=your_bot_secret_key
INTERNAL_SECRET=your_internal_secret

# ── Evolution API Connection ──
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your_evolution_api_key_here

# ── Redis ──
REDIS_URL=redis://redis:6379/1

# ── API Keys (Optional) ──
OPENWEATHER_API_KEY=your_openweather_api_key

# ── App Settings ──
BOT_NAME=BotWave
NEXT_PUBLIC_APP_URL=https://yourdomain.com
PORT=10000

# ── Self-hosted Supabase Auth (GoTrue/Kong) ──
# Used by deploy/docker-compose.yml so auth callback URLs track the active VPS.
GOTRUE_API_EXTERNAL_URL=http://164.68.101.194:8000
NODE_ENV=production

# ── YouTube Cookies (Optional — for !download command) ──
# YOUTUBE_COOKIES=your_cookies_here
