# BotWave Environment Configuration
# Copy this file to .env and fill in the values

# =======================
# SUPABASE CONFIGURATION
# =======================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =======================
# INTERNAL AUTH
# =======================
# Secret key for internal auth between web and bot services
BOT_SECRET_KEY=your_bot_secret_key

# =======================
# AI PROVIDERS
# =======================
# Groq — get free keys at https://console.groq.com/keys
# Comma-separated for smart rotation when rate limits hit.
# Primary provider: 30 req/min per key. More keys = higher throughput.
GROQ_API_KEY=your_groq_api_key
# Multiple keys example: GROQ_API_KEY=key1,key2,key3,key4,key5

# Gemini — get free keys at https://aistudio.google.com/apikey
# Comma-separated for smart rotation when rate limits hit.
# Used as fallback when all Groq keys are rate-limited.
GEMINI_API_KEY=your_gemini_api_key
# Multiple keys example: GEMINI_API_KEY=key1,key2,key3


# =======================
# API KEYS (Optional)
# =======================
OPENWEATHER_API_KEY=your_openweather_api_key

# =======================
# EMAIL (Postal SMTP)
# =======================
POSTAL_SMTP_HOST=postal.botwave.online
POSTAL_SMTP_PORT=25
# SMTP credentials per channel (from Postal admin panel)
POSTAL_SMTP_USER_AUTH=Auth/your_auth_key
POSTAL_SMTP_USER_NOTIFY=Notifications/your_notify_key
POSTAL_SMTP_USER_BILLING=Billing/your_billing_key
POSTAL_SMTP_USER_WELCOME=Welcome/your_welcome_key
POSTAL_SMTP_USER_ALERTS=Alerts/your_alerts_key
POSTAL_SMTP_USER_USERMAIL=UserMail/your_usermail_key

# =======================
# REDIS (for email queue + verification codes)
# =======================
REDIS_URL=redis://localhost:6379

# =======================
# TELEGRAM BOT (Bot Management Mode)
# =======================
# Token for @Botwave_telegrambot (the main bot that creates other bots)
MAIN_TELEGRAM_BOT_TOKEN=your_main_telegram_bot_token
# Your personal Telegram user ID — receives critical error alerts
BOT_OWNER_TELEGRAM_ID=your_telegram_user_id

# =======================
# CLOUDFLARE TURNSTILE (Optional CAPTCHA)
# =======================
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_SITE_KEY=your_turnstile_site_key

# =======================
# OPTIONAL SETTINGS
# =======================
BOT_NAME=BotWave
NEXT_PUBLIC_APP_URL=https://www.botwave.online

# =======================
# API RATE LIMITING (middleware.ts)
# =======================
# Per-IP anti-abuse cap for ALL /api/* routes EXCEPT webhooks AND authenticated
# dashboard users (Supabase auth cookie holders bypass this entirely). Tune up
# if anonymous traffic legitimately needs more headroom; set to 0 to disable.
# Default: 300 requests per 60 seconds.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# =======================
# SETUP INSTRUCTIONS
# =======================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all values above
# 3. Run database migrations in Supabase SQL Editor (in order):
#    - supabase/migrations/001_initial_schema.sql
#    - supabase/migrations/002_rate_limit_settings.sql
#    - supabase/migrations/003_service_role_policies.sql
#    - supabase/migrations/004_user_stats_settings.sql
# 4. Start the app: npm run dev
# 5. Start the bot (separate terminal): npm run bot
