# BotWave Environment Configuration
# Copy this file to .env and fill in the values

# =======================
# SUPABASE CONFIGURATION
# =======================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =======================
# INTERNAL AUTH
# =======================
# Secret key for internal auth between web and bot services
BOT_SECRET_KEY=your_bot_secret_key

# =======================
# API KEYS (Optional)
# =======================
# Users provide their own Groq API key via dashboard (BYOK model)
# No server-side AI key needed — users get free keys at console.groq.com
OPENWEATHER_API_KEY=your_openweather_api_key

# =======================
# OPTIONAL SETTINGS
# =======================
BOT_NAME=BotWave
NEXT_PUBLIC_APP_URL=https://botwave-tx86.onrender.com

# =======================
# SETUP INSTRUCTIONS
# =======================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all values above
# 3. Run database migrations in Supabase SQL Editor (in order):
#    - supabase/migrations/001_initial_schema.sql
#    - supabase/migrations/002_rate_limit_settings.sql
#    - supabase/migrations/003_service_role_policies.sql
#    - supabase/migrations/004_user_stats_settings.sql
# 4. Start the app: npm run dev
# 5. Start the bot (separate terminal): npm run bot
